# Copie para .env (nunca versionado). Valores vazios = recurso desligado.

# Banco: vazio usa o Postgres local do docker-compose. Banco compartilhado: tudo fica no schema DB_SCHEMA.
# Use conexão direta ou pool em modo "session" (o search_path é por sessão).
DATABASE_URL=
DATABASE_SSL=
DB_SCHEMA=cupons

# IA (extração + embeddings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Fontes
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=9000

# NOSSOS links de afiliado (vazio = plataforma aparece sem link nosso)
AMAZON_AFFILIATE_TAG=
ML_AFFILIATE_WORD=
ML_AFFILIATE_TOOL=
SHOPEE_APP_ID=
SHOPEE_SECRET=
AWIN_PUBLISHER_ID=
MAGALU_STORE=

# Cache de busca
PRODUCT_TTL_HOURS=72
COUPON_TTL_MINUTES=60
COUPON_HOT_DAYS=14
