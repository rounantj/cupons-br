{
  "name": "cupons-br",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @cupons/extension build",
    "build:server": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @cupons/extension typecheck",
    "test": "vitest run",
    "migrate": "node packages/db/dist/migrate.js",
    "dev:api": "node --watch --env-file-if-exists=.env apps/api/dist/main.js",
    "dev:worker": "node --watch --env-file-if-exists=.env apps/worker/dist/main.js",
    "watch": "tsc -b tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}