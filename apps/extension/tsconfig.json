{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true, "noEmit": true,
    "types": ["chrome", "vite/client"], "esModuleInterop": true, "resolveJsonModule": true
